# This is a TEMPLATE. The values below are fake.
# 1. Make a copy of this file in the same backend folder and name it ".env"
# 2. Replace the fake values with your real keys.
# Never share or upload the .env file. (.gitignore already stops git uploading it.)

# Needed (Step 2): speech-to-text with Whisper.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Needed (Step 3): grammar feedback with Claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Which Claude model to use. Optional: if you leave this line out,
# the server uses claude-sonnet-5-5.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional but recommended (Step 4): pronunciation scoring with Azure Speech.
# Create a "Speech" resource at https://portal.azure.com, then open it and go to
# "Keys and Endpoint". Copy KEY 1 and the Location/Region (e.g. eastus, westeurope).
# Optional: if these are missing, everything else still works and
# "pronunciation" comes back as null.
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastus

# Optional: only if the server says it can't find ffmpeg even though you
# installed it. Put the full path to ffmpeg.exe here, for example:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
